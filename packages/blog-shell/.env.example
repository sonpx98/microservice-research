# Giscus Comment System
# Get these values from https://giscus.app/
NEXT_PUBLIC_GISCUS_REPO=your-username/your-repo
NEXT_PUBLIC_GISCUS_REPO_ID=R_xxx
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_xxx
KEYSTATIC_GITHUB_CLIENT_ID=string
KEYSTATIC_GITHUB_CLIENT_SECRET=string
KEYSTATIC_SECRET=string

# Pika-Flow Gateway API (Production)
# NEXT_PUBLIC_GATEWAY_URL=https://gateway-crawler.onrender.com/api

# Feature Flags
# Set to 'true' or 'false' to enable/disable features
NEXT_PUBLIC_FEATURE_ALGO_VERSE=false
NEXT_PUBLIC_FEATURE_CV_GENERATOR=true
NEXT_PUBLIC_FEATURE_KNOWLEDGE_GRAPH=true

# Groq API Key
NEXT_PUBLIC_GROQ_API_KEY=string
GROQ_API_KEY=string

# Redis (for rate limiting) - same format as pika-flow
# Upstash:
# REDIS_HOST=your-redis.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your-upstash-password
# REDIS_TLS=true

# Local:
REDIS_HOST=localhost
REDIS_PORT=6379

# supapase:
NEXT_PUBLIC_COBROWSING_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_COBROWSING_SUPABASE_ANON_KEY=your-anon-key
