# Groq API key for AI tarot reading features (optional)
# Get your free API key from: https://console.groq.com/keys
# If not set, users will be prompted to enter API key manually via modal
VITE_GROQ_API_KEY=your_groq_api_key_here

# Tarot app URL for production (without https://)
# This is used by Module Federation to load tarot card images from the correct domain
# Development: Leave empty (will use localhost:5003)
# Production: Set to your Vercel domain (e.g., tarot-omega-six.vercel.app)
VITE_TAROT_URL=url_of_your_tarot_app_here