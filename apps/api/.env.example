# Copy to .env and fill in. Never commit .env.
PORT=3000
MONGO_URI=mongodb://user:password@localhost:27017/pikaflow?authSource=admin

# Shared key for write endpoints (POST /news/crawl, /readings/generate, /conversation/generate, regenerate-audio).
# Generate: openssl rand -hex 32
API_KEY=CHANGE_ME

# AI providers (english-learning). At least one required.
GROQ_API_KEY=
GEMINI_API_KEY=

# Crawler schedule (cron, UTC). Default: daily 01:00 UTC.
# CRAWLER_CRON=0 1 * * *

# Piper TTS. Defaults point at ./tools created by `pnpm setup:tts`.
# PIPER_BIN=tools/piper-venv/bin/piper
# PIPER_MODELS_DIR=tools/piper/models
