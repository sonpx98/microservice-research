# MongoDB Configuration
MONGO_URI=mongodb://user:password@localhost:27017/pikaflow?authSource=admin

# Redis Configuration (Local or Upstash)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your-upstash-password  # Uncomment for Upstash
# REDIS_TLS=true  # Uncomment for Upstash (enables TLS)

# Example Upstash Configuration:
# REDIS_HOST=your-redis.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your-upstash-password
# REDIS_TLS=true

# Crawler API Key (for authentication)
# Generate a secure random string for production
# Example: openssl rand -hex 32
CRAWLER_API_KEY=your-secret-api-key-here

# Gateway API Key (for authentication)
# Copy to .env and fill real secrets
# Used by docker-compose env_file for gateway service
# Do NOT commit your real .env to git
GATEWAY_API_KEY=CHANGE_ME

# Processor API Key (for authentication)
PROCESSOR_API_KEY=your-processor-api-key-here

GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Service URLs (for Gateway to call other services)
# Local development: http://localhost:PORT/api/...
# Docker/K8s: http://service-name:PORT/api/...
TTS_SERVICE_URL=http://localhost:3333/api/tts

